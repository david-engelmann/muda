#compdef muda

_muda() {
    local -a subcommands
    subcommands=(
        'statement:muda statement subcommand'
    )
    if (( CURRENT == 2 )); then
        _describe -t commands 'muda subcommand' subcommands
        return
    fi
    case "${words[2]}" in
        statement) _arguments -s '--month=[value]:value:' '--rates=[file path]:file:_files' '-o+[file path]:file:_files' '--output=[file path]:file:_files' '-h[show help]' '--help[show help]' '*:file:_files' ;;
        *) _files ;;
    esac
}

_muda "$@"
